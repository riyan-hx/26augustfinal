# Local Supabase Edge Function settings.
# Use Razorpay test credentials for local development.
# Never use this file for production secrets; configure those with `supabase secrets set`.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_test_webhook_secret
ALLOWED_ORIGINS=http://localhost:5173
