# Custom domain with wildcard DNS, e.g. lumidai.in. Leave empty to use /p/<slug> links.
VITE_PUBLIC_SITE_DOMAIN=
# Set true in the production frontend environment after configuring Razorpay Edge Function secrets.
VITE_ONLINE_PAYMENTS=true
# Force demo data even when Supabase is configured.
VITE_DEMO_MODE=false