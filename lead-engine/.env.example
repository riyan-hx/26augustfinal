# Copy this file to .env and fill in your own values. Never commit .env.
# Claude does not fill these in for you — every one of them is your credential.

# ── The model that judges leads and writes the mail ──────────────
# Format is provider:model. Groq is used because its API tier is free and needs
# no card. Anthropic/OpenAI work too but both cost money per run.
OPENOUTFIND_AI_MODEL=groq:llama-3.3-70b-versatile
OPENOUTFIND_LLM_API_KEY=

# ── Lead discovery + verified emails ─────────────────────────────
# Free account, 40 credits, no card: https://bettercontact.rocks
# Finding is free. One credit buys one verified work email.
OPENOUTFIND_BETTERCONTACT_API_KEY=

# ── Who is running this ──────────────────────────────────────────
OPENOUTFIND_OPERATOR_EMAIL=
OPENOUTFIND_OPERATOR_COUNTRY=in
OUTSEND_OPERATOR_NAME=Riyan Safeekh

# ── The mailbox the outreach is sent from ────────────────────────
# Use an APP PASSWORD, not your Google login password.
# Strongly recommended: a dedicated address on a domain you own
# (riyan@lumid.in via Google Workspace), NOT your primary personal Gmail.
# Leave the SMTP/IMAP host+port lines out entirely for Google Workspace.
OUTSEND_MAILBOX_ADDRESS=
OUTSEND_MAILBOX_PASSWORD=
OUTSEND_BOOKING_LINK=

# ── Legal ────────────────────────────────────────────────────────
# You must read and accept this yourself before anything sends:
#   https://github.com/eracle/OpenOutreach/blob/main/LEGAL_NOTICE.md
# Set to 1 only once you have actually read it.
OPENOUTFIND_ACCEPT_LEGAL_NOTICE=
